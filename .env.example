# Copy to .env.local and fill in. Never commit .env.local.
# Names only — see CLAUDE.md for what each one gates.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_USER_ID=
# Recipient of brand-inquiry notifications and Reply-To on creator emails.
ADMIN_EMAIL=

# Email (Resend, HTTP API — never SMTP). See CLAUDE.md "Email".
RESEND_API_KEY=
# Exactly: InfluenceIT <noreply@influenceit.app>
EMAIL_FROM=

# Shared secret for /api/cron/* (see CLAUDE.md "Cron"). Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on every scheduled call once it is set
# on the project; generate with `openssl rand -hex 32`. Unset = every cron
# call answers 500.
CRON_SECRET=

# Canonical origin for absolute links (email, Stripe return URLs).
# Deliberately unset locally: the checkout routes fall back to the request
# origin and email falls back to https://influenceit.app.
NEXT_PUBLIC_SITE_URL=

# Scraping / AI
APIFY_API_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_BRAND_STARTER_PRICE_ID=
STRIPE_BRAND_GROWTH_PRICE_ID=
STRIPE_BRAND_PRO_PRICE_ID=
STRIPE_CREATOR_STARTER_PRICE_ID=
STRIPE_CREATOR_ACTIVE_PRICE_ID=
