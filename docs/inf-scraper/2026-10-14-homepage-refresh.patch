+import { NextRequest, NextResponse } from 'next/server';
+import { requestHomepageRefresh } from '@/lib/homepageRefresh';
+
+/**
+ * POST /api/post-import { source } — called by the enrich page once a run's
+ * client-side loop has finished, because no single /api/enrich/process call
+ * knows it was the last. Discovery and Import call requestHomepageRefresh()
+ * directly from their own finishing routes.
+ *
+ * Behind the same session middleware as every other route here.
+ */
+export async function POST(request: NextRequest) {
+  const body = await request.json().catch(() => ({}));
+  const source = typeof body.source === 'string' && body.source ? body.source.slice(0, 64) : 'post-import';
+  await requestHomepageRefresh(source);
+  return NextResponse.json({ requested: true, source });
+}
