diff --git a/docs/migrations/2026-10-14-upsert-creator-posts.sql b/docs/migrations/2026-10-14-upsert-creator-posts.sql
new file mode 100644
index 0000000..f730ebd
--- /dev/null
+++ b/docs/migrations/2026-10-14-upsert-creator-posts.sql
@@ -0,0 +1,139 @@
+-- ============================================================================
+-- upsert_creator_posts(): one batched write per creator, unchanged rows skipped
+--
+-- STATUS: NOT YET APPLIED. Apply by hand in the Supabase SQL editor, one
+-- statement at a time, BEFORE deploying the enrich change that calls it
+-- (app/api/enrich/process/route.ts -> lib/creatorPostsWrite.ts).
+--
+-- WHAT
+--
+-- Takes a jsonb array of mapped posts (mapInstagramPost / mapTikTokPost output)
+-- and, in one call:
+--   1. UPDATEs each post that already exists on (social_profile_id, post_id),
+--      but only when the merged row IS DISTINCT FROM the stored one;
+--   2. INSERTs the posts that do not exist yet (ON CONFLICT DO NOTHING, so a
+--      concurrent insert of the same post is counted as unchanged, not an
+--      error).
+-- Returns one row: inserted, updated, unchanged.
+--
+-- Merging is jsonb_populate_record(stored_row, element): a column whose key is
+-- ABSENT from the element keeps its stored value. That is what the per-post
+-- PostgREST upsert this replaces did (it only SET the columns in the payload),
+-- and it matters because the two mappers send different key sets: an
+-- Instagram post carries no actor_is_* / place_* / post_language keys, and
+-- must not have those columns nulled.
+--
+-- On INSERT an absent key is NULL. None of the columns a mapper can omit has a
+-- default (checked 2026-10-14 against the API schema: actor_is_sponsored,
+-- actor_is_ad, place_*, post_language), and id / created_at are left to their
+-- defaults.
+--
+-- WHY
+--
+-- enrich wrote posts one PostgREST upsert at a time, and an upsert rewrites the
+-- row even when nothing changed. Every re-enrich of a creator therefore made a
+-- new version of every post it re-scraped: dead tuples in creator_posts and
+-- write I/O during imports, the same table influence-ai's homepage statistics
+-- read in full (influence-ai migration 0031, measured 2026-10-14: a plain
+-- count(*) over creator_posts did not finish inside 8 s during an enrich run).
+--
+-- KEEP IN MIND
+--
+-- The UPDATE and INSERT column lists are explicit. A new creator_posts column
+-- that a mapper writes has to be added to both, or it is silently not written.
+--
+-- SECURITY INVOKER: the scraper calls it with the service-role key. EXECUTE is
+-- revoked from anon and authenticated, who have no business writing posts.
+
+create or replace function public.upsert_creator_posts(p_posts jsonb)
+ returns table (inserted integer, updated integer, unchanged integer)
+ language plpgsql
+ set search_path = public
+as $function$
+declare
+  v_total    integer := coalesce(jsonb_array_length(p_posts), 0);
+  v_updated  integer := 0;
+  v_inserted integer := 0;
+begin
+  with input as (
+    select e as elem,
+           (e ->> 'social_profile_id')::uuid as spid,
+           e ->> 'post_id' as post_id
+    from jsonb_array_elements(coalesce(p_posts, '[]'::jsonb)) e
+  ),
+  merged as (
+    select cp.id, cp as old_row, jsonb_populate_record(cp, i.elem) as new_row
+    from input i
+    join creator_posts cp on cp.social_profile_id = i.spid and cp.post_id = i.post_id
+  ),
+  changed as (
+    update creator_posts t
+       set platform           = (m.new_row).platform,
+           post_url           = (m.new_row).post_url,
+           post_type          = (m.new_row).post_type,
+           caption            = (m.new_row).caption,
+           hashtags           = (m.new_row).hashtags,
+           tagged_accounts    = (m.new_row).tagged_accounts,
+           likes_count        = (m.new_row).likes_count,
+           comments_count     = (m.new_row).comments_count,
+           views_count        = (m.new_row).views_count,
+           shares_count       = (m.new_row).shares_count,
+           saves_count        = (m.new_row).saves_count,
+           posted_at          = (m.new_row).posted_at,
+           is_sponsored       = (m.new_row).is_sponsored,
+           sponsor_signals    = (m.new_row).sponsor_signals,
+           detected_brands    = (m.new_row).detected_brands,
+           actor_is_sponsored = (m.new_row).actor_is_sponsored,
+           actor_is_ad        = (m.new_row).actor_is_ad,
+           place_city_code    = (m.new_row).place_city_code,
+           place_country_code = (m.new_row).place_country_code,
+           place_name         = (m.new_row).place_name,
+           place_address      = (m.new_row).place_address,
+           place_city         = (m.new_row).place_city,
+           post_language      = (m.new_row).post_language
+      from merged m
+     where t.id = m.id
+       and m.new_row is distinct from m.old_row
+    returning 1
+  )
+  select count(*) into v_updated from changed;
+
+  with input as (
+    select e as elem,
+           (e ->> 'social_profile_id')::uuid as spid,
+           e ->> 'post_id' as post_id
+    from jsonb_array_elements(coalesce(p_posts, '[]'::jsonb)) e
+  ),
+  added as (
+    insert into creator_posts (
+      social_profile_id, platform, post_id, post_url, post_type, caption,
+      hashtags, tagged_accounts, likes_count, comments_count, views_count,
+      shares_count, saves_count, posted_at, is_sponsored, sponsor_signals,
+      detected_brands, actor_is_sponsored, actor_is_ad, place_city_code,
+      place_country_code, place_name, place_address, place_city, post_language
+    )
+    select r.social_profile_id, r.platform, r.post_id, r.post_url, r.post_type, r.caption,
+           r.hashtags, r.tagged_accounts, r.likes_count, r.comments_count, r.views_count,
+           r.shares_count, r.saves_count, r.posted_at, r.is_sponsored, r.sponsor_signals,
+           r.detected_brands, r.actor_is_sponsored, r.actor_is_ad, r.place_city_code,
+           r.place_country_code, r.place_name, r.place_address, r.place_city, r.post_language
+    from input i
+    cross join lateral jsonb_populate_record(null::creator_posts, i.elem) r
+    where not exists (
+      select 1 from creator_posts cp
+      where cp.social_profile_id = i.spid and cp.post_id = i.post_id
+    )
+    on conflict (social_profile_id, post_id) do nothing
+    returning 1
+  )
+  select count(*) into v_inserted from added;
+
+  return query select v_inserted, v_updated, v_total - v_inserted - v_updated;
+end;
+$function$;
+
+revoke execute on function public.upsert_creator_posts(jsonb) from public, anon, authenticated;
+
+grant execute on function public.upsert_creator_posts(jsonb) to service_role;
+
+notify pgrst, 'reload schema';
diff --git a/lib/creatorPostsWrite.ts b/lib/creatorPostsWrite.ts
new file mode 100644
index 0000000..fe4e984
--- /dev/null
+++ b/lib/creatorPostsWrite.ts
@@ -0,0 +1,37 @@
+import { supabase } from '@/lib/supabase';
+import { POSTS_PER_BATCH, chunk, dedupePosts, type PostKey } from './creatorPostsWriteCore';
+
+export type SavePostsResult = {
+  inserted: number;
+  updated: number;
+  unchanged: number;
+  /** Posts in batches whose call failed; nothing in them was written. */
+  failed: number;
+};
+
+/**
+ * Writes a creator's mapped posts through upsert_creator_posts()
+ * (docs/migrations/2026-10-14-upsert-creator-posts.sql): one call per batch of
+ * up to POSTS_PER_BATCH instead of one PostgREST upsert per post, and a post
+ * whose stored row already matches is not rewritten at all.
+ *
+ * Never throws. A failed batch is logged and counted in `failed`; the other
+ * batches still run, as the per-post loop it replaces let one bad post fail
+ * without aborting the rest.
+ */
+export async function savePostsBatched<T extends PostKey>(posts: T[]): Promise<SavePostsResult> {
+  const result: SavePostsResult = { inserted: 0, updated: 0, unchanged: 0, failed: 0 };
+  for (const batch of chunk(dedupePosts(posts), POSTS_PER_BATCH)) {
+    const { data, error } = await supabase.rpc('upsert_creator_posts', { p_posts: batch });
+    const row = Array.isArray(data) ? data[0] : data;
+    if (error || !row) {
+      console.error(`Failed to save ${batch.length} posts:`, error?.message ?? 'no result row');
+      result.failed += batch.length;
+      continue;
+    }
+    result.inserted += row.inserted ?? 0;
+    result.updated += row.updated ?? 0;
+    result.unchanged += row.unchanged ?? 0;
+  }
+  return result;
+}
