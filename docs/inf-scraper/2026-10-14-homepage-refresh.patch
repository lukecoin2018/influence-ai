@@ -0,0 +1,26 @@
+import { supabase } from '@/lib/supabase';
+
+/**
+ * Tells influence-ai that an import finished, so its homepage figures catch up.
+ *
+ * influence-ai's homepage, share image, report pages and claim teaser read one
+ * precomputed row (homepage_snapshot, influence-ai migration 0031). This
+ * queues a refresh of it: within 5 minutes a pg_cron job in the shared
+ * database runs ANALYZE on creators, social_profiles and creator_posts, then
+ * refresh_homepage_snapshot(), then calls influenceit.app/api/revalidate-home.
+ * Several requests before the job runs collapse into one refresh.
+ *
+ * Queued rather than run here on purpose: the refresh reads all of
+ * creator_posts, which took 23-31 s per query during an enrich run on
+ * 2026-10-14, and a Supabase API call is cut off at 60 s. Inside the database
+ * the job has no such limit.
+ *
+ * Never throws. A failed request is logged; the 6-hourly scheduled refresh
+ * still picks the import up.
+ */
+export async function requestHomepageRefresh(source: string): Promise<void> {
+  const { error } = await supabase.rpc('request_homepage_refresh', { p_source: source, p_analyze: true });
+  if (error) {
+    console.error(`[homepage-refresh] request from ${source} failed: ${error.message}`);
+  }
+}
